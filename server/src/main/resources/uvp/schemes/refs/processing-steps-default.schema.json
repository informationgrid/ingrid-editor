{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "enum": ["publicDisclosure", "publicHearing", "decisionOfAdmission", "scopeOfInvestigation"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "publicDisclosure"
          }
        }
      },
      "then": {
        "$ref": "processing-steps-definition.schema.json#/definitions/PublicDisclosure"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "publicHearing"
          }
        }
      },
      "then": {
        "$ref": "processing-steps-definition.schema.json#/definitions/PublicHearing"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "decisionOfAdmission"
          }
        }
      },
      "then": {
        "$ref": "processing-steps-definition.schema.json#/definitions/DecisionOfAdmission"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "scopeOfInvestigation"
          }
        }
      },
      "then": {
        "$ref": "processing-steps-definition.schema.json#/definitions/ScopeOfInvestigation"
      }
    }
  ],
  "required": [],
  "title": "ProcessingSteps"
}
