{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GeoDatasetLubw",
  "$ref": "../geo-dataset-base.schema.json",
  "properties": {
    "dataQualityInfo": {
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "lineage": {
          "type": "object",
          "unevaluatedProperties": false,
          "properties": {
            "source": {
              "type": "object",
              "unevaluatedProperties": false,
              "$ref": "../geo-dataset-base.schema.json#/definitions/dataQualitySource",
              "properties": {
                "environmentDescription": {
                  "type": ["null", "string"]
                }
              }
            }
          }
        }
      }
    },
    "oac": {
      "type": ["null", "string"]
    },
    "dataManagement": {
      "type": "array",
      "items": {
        "$ref": "../../../general.schema.json#/definitions/KeyValue"
      }
    },
    "protectDataAccessControl": {
      "type": ["null", "string"]
    },
    "featureCatalogueDescription": {
      "unevaluatedProperties": false,
      "$ref": "../geo-dataset-base.schema.json#/definitions/featureDescription",
      "properties": {
        "environmentDescription": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "../../../general.schema.json#/definitions/KeyValue" }
          ]
        },
        "objectAttributes": {
          "type": ["null", "array"]
        },
        "geometries": {
          "type": ["null", "array"]
        }
      }
    }
  },
  "unevaluatedProperties": false
}
