{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wemove.com/schemas/ingrid/schemes/constraints/if_isInspireIdentified-geo-dataset",
  "type": "object",
  "if": {
    "properties": {
      "properties": {
        "type": "object",
        "properties": {
          "isInspireIdentified": { "const": "conform" }
        },
        "required": ["isInspireIdentified"]
      }
    },
    "required": ["properties"]
  },
  "then": {
    "properties": {
      "themes": {
        "type": "array",
        "minItems": 1
      },
      "spatialScope": {
        "type": "object"
      },
      "spatialRepresentationType": {
        "type": "array",
        "minItems": 1
      },
      "distribution": {
        "type": "object",
        "required": [
          "format"
        ],
        "properties": {
          "format": {
            "type": "array",
            "minItems": 1
          }
        }
      },
      "conformanceResult": {
        "type": "array",
        "minItems": 1,
        "contains": {
          "type": "object",
          "required": ["specification", "pass"],
          "properties": {
            "specification": {
              "type": "object",
              "properties": {
                "key": { "const": "12" }
              },
              "required": ["key"]
            },
            "pass": {
              "type": "object",
              "properties": {
                "key": { "const": "1" }
              },
              "required": ["key"]
            }
          }
        }
      },
      "resource": {
        "type": "object",
        "properties": {
          "accessConstraints": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": ["accessConstraints"]
      }
    },
    "required": ["themes", "spatialScope", "spatialRepresentationType", "distribution", "conformanceResult", "resource"]
  }
}
