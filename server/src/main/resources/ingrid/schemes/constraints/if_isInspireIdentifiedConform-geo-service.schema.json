{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wemove.com/schemas/ingrid/schemes/constraints/if_isInspireIdentified-geo-service",
  "type": "object",
  "if": {
    "properties": {
      "properties": {
        "type": "object",
        "properties": {
          "isInspireIdentified": { "const": "relevant" }
        },
        "required": ["isInspireIdentified"]
      }
    },
    "required": ["properties"]
  },
  "then": {
    "properties": {
      "themes": {
        "type": "array",
        "minItems": 1
      }
    },
    "required": ["themes"]
  }
}
