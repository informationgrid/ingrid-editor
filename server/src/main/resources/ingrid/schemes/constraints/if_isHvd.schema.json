{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wemove.com/schemas/ingrid/schemes/constraints/if_isHvd",
  "type": "object",
  "if": {
    "properties": {
      "properties": {
        "type": "object",
        "properties": {
          "isHvd": { "const": true }
        },
        "required": ["isHvd"]
      }
    },
    "required": ["properties"]
  },
  "then": {
    "properties": {
      "hvdCategories": {
        "type": "array",
        "minItems": 1
      },
      "properties": {
        "type": "object",
        "properties": {
          "isOpenData": {
            "type": "boolean",
            "const": true
          }
        },
        "required": ["isOpenData"]
      }
    },
    "required": ["properties"]
  }
}
