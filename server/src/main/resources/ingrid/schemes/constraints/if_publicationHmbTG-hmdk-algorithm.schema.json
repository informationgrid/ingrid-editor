{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wemove.com/schemas/ingrid/schemes/constraints/if_publicationHmbTG-hmdk-algorithm",
  "type": "object",
  "if": {
    "properties": {
      "properties": {
        "type": "object",
        "properties": {
          "publicationHmbTG": { "const": true }
        },
        "required": ["publicationHmbTG"]
      }
    },
    "required": ["properties"]
  },
  "then": {
    "properties": {
      "openDataCategories": {
        "type": "array",
        "minItems": 1
      },
      "informationHmbTG": {
        "type": "array",
        "minItems": 1
      },
      "pointOfContact": {
        "type": "array",
        "minItems": 1,
        "contains": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "type": "object",
              "properties": {
                "key": { "const": "10" }
              },
              "required": ["key"]
            }
          }
        }
      }
    },
    "anyOf": [
      {
        "properties": {
          "apiUrl": { "type": "string", "minLength": 1 }
        },
        "required": ["apiUrl"]
      },
      {
        "properties": {
          "sourceCodeUrl": { "type": "string", "minLength": 1 }
        },
        "required": ["sourceCodeUrl"]
      },
      {
        "properties": {
          "websiteUrl": { "type": "string", "minLength": 1 }
        },
        "required": ["websiteUrl"]
      },
      {
        "properties": {
          "exampleUrl": { "type": "string", "minLength": 1 }
        },
        "required": ["exampleUrl"]
      },
      {
        "properties": {
          "publiccodeUrl": { "type": "string", "minLength": 1 }
        },
        "required": ["publiccodeUrl"]
      },
      {
        "properties": {
          "additionalUrls": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": ["url"],
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "required": ["additionalUrls"]
      },
      {
        "properties": {
          "fileReferences": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": ["fileReferences"]
      }
    ]
  }
}
