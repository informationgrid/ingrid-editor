{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/definitions/McloudAddress",
  "definitions": {
    "McloudAddress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_uuid": {
          "type": "string"
        },
        "_type": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "$ref": "../../general.schema.json#/definitions/AddressClass"
        },
        "contact": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Contact"
          },
          "minItems": 1
        },
        "organization": {
          "type": "string"
        }
      },
      "required": ["_uuid", "_type", "organization", "contact"],
      "title": "Address"
    },
    "Contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "../../general.schema.json#/definitions/KeyValue"
        },
        "connection": {
          "type": "string"
        }
      },
      "required": ["connection", "type"],
      "title": "Contact"
    }
  }
}
