{
  "name": "ige-ng",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "fix-prettier": "prettier -w src",
    "browserslist": "browserslist --update-db",
    "build": "ng build ige-ng",
    "prod": "ng build ige-ng --configuration production",
    "prod-stats": "ng build ige-ng --configuration production --stats-json",
    "update-angular": "ng update @angular/cli @angular/core --allow-dirty",
    "update-material": "ng update @angular/cdk @angular/material --allow-dirty --force",
    "test": "ng test",
    "test-ci": "ng test --no-watch --no-progress --reporters=junit --reporters=tap-flat --output-file=target/surefire-reports/unit-test.xml",
    "lint": "ng lint",
    "wba": "webpack-bundle-analyzer dist/stats.json",
    "sme": "source-map-explorer"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@flowjs/flow.js": "^2.14.1",
    "@flowjs/ngx-flow": "^21.0.0",
    "@geoman-io/leaflet-geoman-free": "^2.20.3",
    "@jsverse/transloco": "8.4.0",
    "@ngneat/dirty-check-forms": "^3.0.3",
    "@ngrx/signals": "22.0.1",
    "@ngx-formly/core": "7.1.0",
    "@ngx-formly/material": "7.1.0",
    "@stomp/rx-stomp": "^2.4.0",
    "@stomp/stompjs": "^7.5.0",
    "@terraformer/wkt": "^2.2.2",
    "angular-split": "^20.0.0",
    "cronstrue": "^3.37.0",
    "diff": "^9.0.0",
    "file-saver-es": "^2.0.5",
    "leaflet": "^1.9.4",
    "material-design-icons-iconfont": "^6.7.0",
    "ngx-mat-select-search": "^9.0.0",
    "ngx-matomo-client": "^9.1.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@cyclonedx/yarn-plugin-cyclonedx": "^3.4.0",
    "@ngneat/spectator": "^22.1.0",
    "@types/file-saver-es": "~2.0.3",
    "@types/flowjs": "~2.13.14",
    "@types/jsdom": "^27",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.5",
    "@types/terraformer__wkt": "^2.0.3",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.1.2",
    "prettier": "3.5.3",
    "source-map-explorer": "^2.5.3",
    "stop-only": "^3.4.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "npm": "please-use-yarn",
    "yarn": ">= 3.0.0",
    "node": ">= 20.19.0"
  },
  "lint-staged": {
    "*.{ts,scss,js,css,html,md,json}": "prettier --check",
    "*.{spec,cy}.ts": "yarn stop-only --folder"
  },
  "packageManager": "yarn@4.17.0"
}
