{
  "name": "ige-ng",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "fix-prettier": "prettier -w src",
    "browserslist": "browserslist --update-db",
    "build": "ng build ige-ng",
    "prod": "ng build ige-ng --configuration production",
    "prod-stats": "ng build ige-ng --configuration production --stats-json",
    "update-angular": "ng update @angular/cli @angular/core --allow-dirty",
    "update-material": "ng update @angular/cdk @angular/material --allow-dirty --force",
    "test": "ng test",
    "test-ci": "ng test --no-watch --no-progress --reporters=junit --reporters=tap-flat --output-file=target/surefire-reports/unit-test.xml",
    "lint": "ng lint",
    "wba": "webpack-bundle-analyzer dist/stats.json",
    "sme": "source-map-explorer"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.5",
    "@angular/cdk": "^21.2.3",
    "@angular/common": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/forms": "^21.2.5",
    "@angular/material": "^21.2.3",
    "@angular/platform-browser": "^21.2.5",
    "@angular/platform-browser-dynamic": "^21.2.5",
    "@angular/router": "^21.2.5",
    "@flowjs/flow.js": "^2.14.1",
    "@flowjs/ngx-flow": "^20.0.2",
    "@geoman-io/leaflet-geoman-free": "^2.15.0",
    "@jsverse/transloco": "8.2.0",
    "@ngneat/dirty-check-forms": "^3.0.3",
    "@ngrx/signals": "20.1.0",
    "@ngx-formly/core": "7.0.1",
    "@ngx-formly/material": "7.0.1",
    "@stomp/rx-stomp": "^2.3.0",
    "@stomp/stompjs": "^7.2.1",
    "@terraformer/wkt": "^2.2.1",
    "angular-split": "^20.0.0",
    "cronstrue": "^3.9.0",
    "diff": "^8.0.3",
    "file-saver-es": "^2.0.5",
    "keycloak-angular": "^20.0.0",
    "keycloak-js": "25.0.6",
    "leaflet": "^1.9.4",
    "material-design-icons-iconfont": "^6.7.0",
    "ngx-mat-select-search": "^8.0.4",
    "ngx-matomo-client": "^9.0.1",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.5",
    "@ngneat/spectator": "^22.1.0",
    "@types/file-saver-es": "~2.0.3",
    "@types/flowjs": "~2.13.14",
    "@types/jsdom": "^27",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^20.19.5",
    "@types/terraformer__wkt": "^2.0.3",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.1.2",
    "prettier": "3.5.3",
    "source-map-explorer": "^2.5.3",
    "stop-only": "^3.4.3",
    "typescript": "~5.9.3",
    "vitest": "^4.0.14"
  },
  "engines": {
    "npm": "please-use-yarn",
    "yarn": ">= 3.0.0",
    "node": ">= 20.19.0"
  },
  "lint-staged": {
    "*.{ts,scss,js,css,html,md,json}": "prettier --check",
    "*.{spec,cy}.ts": "yarn stop-only --folder"
  },
  "packageManager": "yarn@4.6.0"
}
