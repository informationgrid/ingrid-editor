{
  "name": "ige-ng",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "fix-prettier": "prettier -w src",
    "browserslist": "browserslist --update-db",
    "build": "ng build ige-ng",
    "prod": "ng build ige-ng --configuration production",
    "prod-stats": "ng build ige-ng --configuration production --stats-json",
    "update-angular": "ng update @angular/cli @angular/core --allow-dirty",
    "update-material": "ng update @angular/cdk @angular/material --allow-dirty --force",
    "test": "ng test",
    "test-headless": "ng test --no-watch --no-progress --browsers=ChromeHeadless",
    "lint": "ng lint",
    "wba": "webpack-bundle-analyzer dist/stats.json",
    "sme": "source-map-explorer"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.1.0",
    "@angular/cdk": "^20.1.0",
    "@angular/common": "^20.1.0",
    "@angular/compiler": "^20.1.0",
    "@angular/core": "^20.1.0",
    "@angular/forms": "^20.1.0",
    "@angular/material": "^20.1.0",
    "@angular/platform-browser": "^20.1.0",
    "@angular/platform-browser-dynamic": "^20.1.0",
    "@angular/router": "^20.1.0",
    "@flowjs/flow.js": "^2.14.1",
    "@flowjs/ngx-flow": "^19.0.0",
    "@geoman-io/leaflet-geoman-free": "^2.15.0",
    "@jsverse/transloco": "7.6.1",
    "@ngneat/dirty-check-forms": "^3.0.3",
    "@ngneat/until-destroy": "^10.0.0",
    "@ngrx/signals": "19.2.1",
    "@ngx-formly/core": "7.0.0",
    "@ngx-formly/material": "7.0.0",
    "@stomp/rx-stomp": "^2.0.1",
    "@stomp/stompjs": "^7.1.1",
    "@terraformer/wkt": "^2.2.1",
    "angular-split": "^19.0.0",
    "cronstrue": "^3.0.0",
    "diff": "^8.0.2",
    "file-saver-es": "^2.0.5",
    "keycloak-angular": "^20.0.0",
    "keycloak-js": "25.0.6",
    "leaflet": "^1.9.4",
    "material-design-icons-iconfont": "^6.7.0",
    "ngx-mat-select-search": "^8.0.2",
    "ngx-matomo-client": "^7.0.1",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "uuid": "^11.1.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.1.0",
    "@angular/cli": "^20.1.0",
    "@angular/compiler-cli": "^20.1.0",
    "@ngneat/spectator": "^20.0.0",
    "@types/file-saver-es": "~2.0.3",
    "@types/flowjs": "~2.13.14",
    "@types/jasmine": "~5.1.8",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^20.19.5",
    "@types/terraformer__wkt": "^2.0.3",
    "jasmine-core": "^5.8.0",
    "jasmine-reporters": "^2.5.2",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "karma-junit-reporter": "^2.0.1",
    "lint-staged": "^16.1.2",
    "prettier": "3.5.3",
    "source-map-explorer": "^2.5.3",
    "stop-only": "^3.4.3",
    "typescript": "~5.8.3"
  },
  "engines": {
    "npm": "please-use-yarn",
    "yarn": ">= 3.0.0",
    "node": ">= 20.19.0"
  },
  "lint-staged": {
    "*.{ts,scss,js,css,html,md,json}": "prettier --check",
    "*.{spec,cy}.ts": "yarn stop-only --folder"
  },
  "packageManager": "yarn@4.6.0"
}
