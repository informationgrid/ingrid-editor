{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Server",
            "type": "shell",
            "command": "./gradlew",
            "args": ["bootRun", "--args='--spring.profiles.active=dev,ingrid'", "-PjavaVersion=25"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Debug Server",
            "type": "shell",
            "command": "./gradlew",
            "args": ["bootRun", "--args='--spring.profiles.active=dev,ingrid'", "-PjavaVersion=25", "--debug-jvm"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Frontend",
            "type": "shell",
            "command": "yarn",
            "args": ["start"],
            "options": {
                "cwd": "${workspaceFolder}/frontend" 
            },
            "problemMatcher": []
        }
    ]
}
